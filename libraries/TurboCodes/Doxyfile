# Doxygen configuration: TurboCodes manual
#
# Run from this folder:   doxygen Doxyfile
# Output:                 doc/html (HTML) and doc/latex (LaTeX; PDF with "latexmk -pdf refman.tex" in doc/latex)
# doc/build_docs.sh (repository root) builds every manual in dependency order and checks that there are no warnings.

@INCLUDE               = ../../doc/Doxyfile.common

PROJECT_NAME           = "TurboCodes"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Soft-decoded Turbo Codes and digital modulations for Strengthened Fuzzy Extractors"
PROJECT_LOGO           = doxygen/trellis.png
OUTPUT_DIRECTORY       = doc
INPUT                  = doxygen/turbocodes.md \
                         .
IMAGE_PATH             = doxygen
USE_MDFILE_AS_MAINPAGE = doxygen/turbocodes.md
INCLUDE_PATH           = . ..
CITE_BIB_FILES         = ../../doc/bibliography.bib
LATEX_EXTRA_STYLESHEET = ../../doc/doxygen_sfe.sty
GENERATE_TAGFILE       = doc/TurboCodes.tag
# Links to the manuals of the modules this one depends on (build them first: doc/build_docs.sh does it)
TAGFILES               = \
                         ../../libraries/GMMLite/doc/GMMLite.tag=../../../../libraries/GMMLite/doc/html
